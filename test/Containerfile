FROM docker.io/library/debian:13-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server procps sudo && \
    rm -rf /var/lib/apt/lists/* && mkdir -p /run/sshd && \
    useradd -m -s /bin/bash alumno && echo 'alumno:HEIMDALL_SECRET_TEST_12345' | chpasswd && \
    usermod -aG sudo alumno && \
    useradd -m -s /bin/bash invitado && echo 'invitado:HEIMDALL_SECRET_TEST_12345' | chpasswd && \
    install -d -m 750 /etc/kea && echo 'subnet4 solo-root' > /etc/kea/kea-dhcp4.conf && \
    chmod 640 /etc/kea/kea-dhcp4.conf && \
    sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    ssh-keygen -A && rm -f /etc/ssh/ssh_host_ed25519_key* /etc/ssh/ssh_host_ecdsa_key*
EXPOSE 22
CMD ["/usr/sbin/sshd","-D","-e"]
