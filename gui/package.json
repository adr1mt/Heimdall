{
  "name": "heimdall-gui",
  "version": "1.0.1",
  "description": "Heimdall GUI: interfaz de escritorio del motor de evaluacion Heimdall",
  "desktopName": "heimdall-gui",
  "main": "./out/main/index.js",
  "author": {
    "name": "Adria Munoz",
    "email": "adriamt@elpuig.xeill.net"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/adr1mt/Heimdall",
  "repository": "github:adr1mt/Heimdall",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run verify:preload",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "verify:preload": "node scripts/verify-preload.mjs",
    "icon": "python3 scripts/make-icon.py",
    "screenshot": "esbuild scripts/screenshot.ts --bundle --platform=node --format=esm --outfile=/tmp/heimdall-shot.mjs --external:electron && node_modules/electron/dist/electron /tmp/heimdall-shot.mjs --no-sandbox",
    "lab-run": "esbuild scripts/lab-run.ts --bundle --platform=node --format=esm --outfile=/tmp/heimdall-lab-run.mjs --external:electron && node_modules/electron/dist/electron /tmp/heimdall-lab-run.mjs --no-sandbox",
    "examen-lab": "esbuild scripts/examen-lab.ts --bundle --platform=node --format=esm --outfile=/tmp/heimdall-examen-lab.mjs --external:electron && node_modules/electron/dist/electron /tmp/heimdall-examen-lab.mjs --no-sandbox",
    "dist": "npm run build && node scripts/package-linux.mjs && node scripts/verify-package.mjs",
    "editor-lab": "esbuild scripts/editor-lab.ts --bundle --platform=node --format=esm --outfile=/tmp/heimdall-editor-lab.mjs --external:electron && node_modules/electron/dist/electron /tmp/heimdall-editor-lab.mjs --no-sandbox",
    "report-lab": "esbuild scripts/report-lab.ts --bundle --platform=node --format=esm --outfile=/tmp/heimdall-report-lab.mjs --external:electron && node_modules/electron/dist/electron /tmp/heimdall-report-lab.mjs --no-sandbox",
    "postinstall": "node scripts/install-electron.mjs"
  },
  "dependencies": {
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/packager": "20.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.1.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.64.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=12.2.1"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
